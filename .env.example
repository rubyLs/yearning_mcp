# Yearning 连接
YEARNING_URL=http://localhost:8000
YEARNING_USERNAME=admin
YEARNING_PASSWORD=Yearning_admin
YEARNING_LOGIN_TYPE=general
YEARNING_TIMEOUT=30
# false=开放写工具（提交/审核/撤回）；true=仅只读工具
YEARNING_READ_ONLY=false
# 自签名证书环境可设为 true（生产勿用）
YEARNING_INSECURE=false

# MCP 传输：stdio | sse | streamable-http
# Docker 镜像默认使用 streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8080
# HTTP / Docker 场景建议设置，保护 MCP 接口
MCP_AUTH_TOKEN=your-strong-token
MCP_STATELESS_HTTP=false
MCP_LOG_LEVEL=info
