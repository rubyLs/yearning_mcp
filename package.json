{
  "name": "@rubyls/yearning-mcp",
  "version": "1.0.0",
  "description": "Yearning SQL 审核平台 MCP Server：工单提交/审核/查询/表结构探查",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "yearning-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "yearning",
    "sql-audit",
    "model-context-protocol",
    "cursor",
    "claude"
  ],
  "author": "rubyLs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubyLs/yearning_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rubyLs/yearning_mcp/issues"
  },
  "homepage": "https://github.com/rubyLs/yearning_mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "msgpackr": "^2.0.5",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.5",
    "typescript": "^5.8.2"
  }
}
